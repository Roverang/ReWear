# Copy of the variable names used by backend.env (dummy values only).
# Generate a real backend.env with: powershell -ExecutionPolicy Bypass -File scripts/make-local-env.ps1

# Used by the postgres container (docker-compose.yml)
POSTGRES_DB=rewear
POSTGRES_USER=rewear
POSTGRES_PASSWORD=change-me

# Used by the Spring Boot backend
DB_URL=jdbc:postgresql://localhost:5432/rewear
DB_USERNAME=rewear
DB_PASSWORD=change-me
JWT_SECRET=base64-encoded-64-random-bytes
FRONTEND_ORIGIN=http://localhost:8080
